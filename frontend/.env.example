# URL base de la API del backend (debe terminar en /api/v1/).
# En desarrollo local: http://127.0.0.1:8000/api/v1/
# En producción: la URL real de tu backend, ej. https://api.mimimmdart.com/api/v1/
VITE_API_URL=http://127.0.0.1:8000/api/v1/

# Client ID de OAuth de Google (no es secreto, es público) — debe coincidir
# exactamente con el GOOGLE_CLIENT_ID del backend, son la misma app de Google.
VITE_GOOGLE_CLIENT_ID=

# Client ID de la app de PayPal (no es secreto) — usa el de la app "Sandbox"
# en local y el de la app "Live" en producción. Debe corresponder al mismo
# modo (PAYPAL_MODE) que el PAYPAL_CLIENT_ID/SECRET del backend, o las
# capturas de pago van a fallar.
VITE_PAYPAL_CLIENT_ID=
